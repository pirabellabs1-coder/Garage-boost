# =====================================================================
# Garage Boost — Configuration Hostinger (Apache)
# Sécurité, performance, SEO
# =====================================================================

# ---------------------------------------------------------------------
# 1. HTTPS forcé (déjà actif chez Hostinger mais double sécurité)
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirection www → non-www (SEO - canonical)
  RewriteCond %{HTTP_HOST} ^www\.garageboost\.fr$ [NC]
  RewriteRule ^(.*)$ https://garageboost.fr/$1 [L,R=301]
</IfModule>

# ---------------------------------------------------------------------
# 2. Headers de sécurité
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  # HSTS : forcer HTTPS pendant 1 an
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Empêche le clickjacking (iframe externe interdit)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Empêche le MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Filtre XSS du navigateur
  Header always set X-XSS-Protection "1; mode=block"

  # Politique de référent (limite la fuite d'info)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Politique de permissions (bloque géoloc, micro, caméra par défaut)
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # CSP : Content Security Policy (sécurité XSS + injection)
  # Note : adapter si vous ajoutez des trackers (GA, Matomo)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.clarity.ms https://*.clarity.ms https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://maps.gstatic.com https://maps.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://*.facebook.com https://*.facebook.net https://*.clarity.ms; frame-src 'self' https://maps.google.com https://www.google.com; connect-src 'self' https://formsubmit.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://*.facebook.com; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; base-uri 'self'"

  # Empêche les bots de récupérer les versions cachées
  Header set X-Robots-Tag "index, follow, max-image-preview:large"

  # Cache-control pour les assets statiques
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------
# 3. Compression (réduit la taille des fichiers, améliore Core Web Vitals)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------
# 4. Protection des fichiers sensibles
# ---------------------------------------------------------------------
# Bloque l'accès aux fichiers cachés (.git, .env, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Bloque l'accès au dossier generator (scripts Node.js, données)
RedirectMatch 403 ^/generator/.*$

# Bloque les fichiers de config et backup
<FilesMatch "\.(bak|config|sql|fla|log|md|sh|inc|swp|dist|old|json|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Autorise robots.txt, sitemap.xml, llms.txt, security.txt explicitement
<FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt|security\.txt|humans\.txt)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
# 5. Pages d'erreur custom
# ---------------------------------------------------------------------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ---------------------------------------------------------------------
# 6. Désactiver le listing des dossiers
# ---------------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------------
# 7. Protection contre le hotlinking d'images (optionnel)
# ---------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTP_REFERER} !^$
#   RewriteCond %{HTTP_REFERER} !^https://(www\.)?garageboost\.fr/.*$ [NC]
#   RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F]
# </IfModule>

# ---------------------------------------------------------------------
# 8. ETags et performance
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# ---------------------------------------------------------------------
# 9. URLs propres (extension .html optionnelle)
# ---------------------------------------------------------------------
<IfModule mod_rewrite.c>
  # Permettre /tarifs au lieu de /tarifs.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>
